# Connexion des membres (Google OAuth)
# Console Google Cloud > API et services > Identifiants > ID client OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Genere avec : openssl rand -base64 32
AUTH_SECRET=

# Service account qui lit Search Console et GA4
# Console Google Cloud > Comptes de service > Cles > Ajouter une cle JSON
# Coller l'email du compte et la cle privee du fichier JSON telecharge
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Suivi GEO — vide en V1, a remplir quand le fournisseur sera choisi
GEO_API_KEY=
